{
  "name": "worker-ssh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.7.0",
  "type": "module",
  "description": "透過 Cloudflare Worker 提供網頁版 SSH 連線、SFTP、主機監控與連線設定雲同步（Liquid Glass 暗色主題）",
  "scripts": {
    "build:wasm": "node scripts/build-go.mjs",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --platform=neutral --outfile=dist/worker/index.js --external:cloudflare:* --external:../../dist/worker/ssh.wasm --legal-comments=none",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:wasm && npm run build:worker && npm run build:client",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "test": "npm run test:deployment && npm run test:frontend && npm run test:worker && npm run test:go",
    "test:deployment": "node --test test/unit/deployment/*.test.mjs",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:go": "cd go-ssh && go test ./...",
    "dev": "npm run build && wrangler dev",
    "check:split": "node scripts/check-split.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@types/node": "^24.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "simple-icons": "^15.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "papaparse": "^5.6.0"
  }
}
